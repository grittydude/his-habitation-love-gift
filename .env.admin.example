# Organiser-only configuration for scripts/provision-codes.mjs and
# scripts/export-pairings.mjs. Copy to .env.admin.local (git-ignored).
# Never commit this file, never add it to Vercel/Netlify, never prefix with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Supabase dashboard → Project Settings → API → service_role (or a "secret" key).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Live site address, used to build each member's personal sign-in link.
SITE_URL=https://YOUR-SITE.vercel.app
